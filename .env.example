# AI Wealth Navigator - environment configuration
#
# Copy to `.env` and edit. `npm run dev` loads that file if it is present.
# Every value below has a working default, so the
# platform runs with this file absent: no credentials, no AWS account, no
# database. The agent falls back to its deterministic engine, which plans,
# calls the same tools and grounds every figure - it just narrates from
# templates instead of Claude.

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info           # debug | info | warn | error

# ----------------------------------------------------------------------------
# Reasoning engine
# ----------------------------------------------------------------------------
# Leave LLM_PROVIDER unset to auto-detect:
#   ANTHROPIC_API_KEY present            -> anthropic
#   GROQ_API_KEY present                 -> groq
#   running in Lambda with a region      -> bedrock
#   none of the above                    -> deterministic
# LLM_PROVIDER=anthropic

# Option A - the Anthropic API. Convenient locally.
# ANTHROPIC_API_KEY=sk-ant-...

# Option B - Amazon Bedrock. What the deployed stack uses, because the Lambda
# execution role carries the permission and there is no key to store or rotate.
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_PROFILE=your-local-profile

# Option C - Groq. Open-weights models (gpt-oss, qwen) over an OpenAI-compatible
# endpoint. The tools, the finance engine and the grounding check are identical
# on every provider, so this only changes who writes the prose.
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...

# Any tool-capable Groq model. reasoning_effort is sent only to the gpt-oss and
# qwen3 families - groq/compound rejects the parameter with a 400.
# GROQ_MODEL=openai/gpt-oss-120b

# Completion ceiling for the Groq path, deliberately below the 8000 the
# orchestrator asks for: narration does not need 8000 tokens, and on a reasoning
# model a runaway chain of thought is billed as completion.
#
# It is NOT a rate-limit control. Groq meters the per-minute allowance on prompt
# tokens plus the completion actually written - a request carrying
# max_tokens: 4000 was admitted against a live free account with 927 tokens left
# in the minute, and cost 151. Reserving less does not buy headroom.
# GROQ_MAX_TOKENS=1500

# Total time one Groq call may spend waiting out a rate limit before giving up
# and letting the deterministic engine answer. Groq states the wait it wants in
# the 429 body and it is honoured when it fits; a free account asks for 9-10s
# mid-run, so a budget below that refuses the retries most worth taking.
# GROQ_RETRY_BUDGET_MS=12000

# For a Groq-compatible gateway.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Which tools the model is offered on each step: `plan` (the router's chosen
# toolchain plus get_financial_snapshot and search_knowledge) or `all` (the
# whole catalogue). Defaults to `plan` on Groq and `all` everywhere else.
#
# The catalogue is re-sent in full on every step, and all fourteen schemas cost
# 1,641 prompt tokens against Groq's tokeniser. Three steps of that is 4,900 of
# a free account's 8,000-token minute spent restating tools the plan was never
# going to use, which is what made a single question run the allowance out and
# finish on the deterministic engine. Measured on one question, end to end:
# 10,300 tokens per run before, 5,563 after narrowing and after dropping the
# opening turn to low reasoning effort.
#
# Set it to `all` if you move to a paid tier and would rather the model chose
# freely from everything the platform can do.
# AGENT_TOOL_SCOPE=plan

# First-party model id. The Bedrock client adds the `anthropic.` prefix itself.
# claude-sonnet-5 is the cheaper option if cost matters more than nuance.
CLAUDE_MODEL=claude-opus-5

# Ceiling on agent tool-calling iterations, bounding cost and latency per question.
MAX_AGENT_STEPS=6

# ----------------------------------------------------------------------------
# Simulation
# ----------------------------------------------------------------------------
# Monte Carlo paths per server-side run. 2000 is a good accuracy/latency trade;
# the browser drops to 600 mid-drag and raises it again when the slider settles.
SIMULATION_PATHS=2000

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# Unset uses the in-memory store, which is what local development wants -
# restart the server and you get a clean slate. Set by the CDK stack in AWS.
# TABLE_NAME=WealthNavigator-dev-DataTable

# ----------------------------------------------------------------------------
# Client
# ----------------------------------------------------------------------------
# Unset in development: Vite proxies /api to the server, so the app and the API
# share one origin and there is no CORS to configure. In production CloudFront
# does the same job, so this normally stays unset there too.
# VITE_API_URL=https://d1234abcd.cloudfront.net

# Comma-separated allowlist, or * for any origin.
CORS_ORIGINS=*
