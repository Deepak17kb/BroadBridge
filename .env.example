# AI Wealth Navigator - environment configuration
#
# Copy to `.env` and edit. Every value below has a working default, so the
# platform runs with this file absent: no credentials, no AWS account, no
# database. The agent falls back to its deterministic engine, which plans,
# calls the same tools and grounds every figure - it just narrates from
# templates instead of Claude.

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info           # debug | info | warn | error

# ----------------------------------------------------------------------------
# Reasoning engine
# ----------------------------------------------------------------------------
# Leave LLM_PROVIDER unset to auto-detect:
#   ANTHROPIC_API_KEY present            -> anthropic
#   running in Lambda with a region      -> bedrock
#   neither                              -> deterministic
# LLM_PROVIDER=anthropic

# Option A - the Anthropic API. Convenient locally.
# ANTHROPIC_API_KEY=sk-ant-...

# Option B - Amazon Bedrock. What the deployed stack uses, because the Lambda
# execution role carries the permission and there is no key to store or rotate.
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_PROFILE=your-local-profile

# First-party model id. The Bedrock client adds the `anthropic.` prefix itself.
# claude-sonnet-5 is the cheaper option if cost matters more than nuance.
CLAUDE_MODEL=claude-opus-5

# Ceiling on agent tool-calling iterations, bounding cost and latency per question.
MAX_AGENT_STEPS=6

# ----------------------------------------------------------------------------
# Simulation
# ----------------------------------------------------------------------------
# Monte Carlo paths per server-side run. 2000 is a good accuracy/latency trade;
# the browser drops to 600 mid-drag and raises it again when the slider settles.
SIMULATION_PATHS=2000

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# Unset uses the in-memory store, which is what local development wants -
# restart the server and you get a clean slate. Set by the CDK stack in AWS.
# TABLE_NAME=WealthNavigator-dev-DataTable

# ----------------------------------------------------------------------------
# Client
# ----------------------------------------------------------------------------
# Unset in development: Vite proxies /api to the server, so the app and the API
# share one origin and there is no CORS to configure. In production CloudFront
# does the same job, so this normally stays unset there too.
# VITE_API_URL=https://d1234abcd.cloudfront.net

# Comma-separated allowlist, or * for any origin.
CORS_ORIGINS=*
